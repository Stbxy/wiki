{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6b22\u8fce\u6765\u5230Stbxy","text":"<p>\u6211\u5c06\u5728\u8fd9\u91cc\u8bb0\u5f55\u6211\u5bf9\u5b66\u4e60\u8fd9\u5ea7\u9ad8\u5c71\u7684\u6500\u767b\u4e4b\u65c5</p> <p>\u6216\u8bb8\u6211\u5728\u4e0d\u4e45\u7684\u5c06\u6765\u5c31\u4f1a\u653e\u5f03\u8bb0\u5f55\uff0c\u4f46\u6211\u4e5f\u8d70\u5230\u4e86\u8fd9\u91cc\uff0c\u4e0d\u662f\u5417\uff1f--2026.10</p> <p>\u6211\u60f3\u4e70\u4ef6\u6f02\u4eae\u7684\u8863\u670d   --\u51e1\u59d7\u7b60</p>"},{"location":"volunteer/first-meeting-2026-10/","title":"\u9752\u534f\u4f1a\u8bae","text":""},{"location":"volunteer/first-meeting-2026-10/#1","title":"1. \u4e00\u4e2a\u7b80\u5355\u7684\u81ea\u6211\u4ecb\u7ecd","text":"<ul> <li>\u5927\u5bb6\u597d......  </li> <li>\u6b22\u8fce\u5927\u5bb6\u52a0\u5165\u9752\u534f\u5927\u5bb6\u5ead\uff0c\u5e0c\u671b\u5927\u5bb6\u5728\u672a\u6765\u4e00\u5e74\u7684\u5de5\u4f5c\u4e2d\u76f8\u4e92\u4e86\u89e3\uff0c\u80fd\u591f\u4ea4\u5230\u4e00\u4e9b- \u670b\u53cb\uff0c\u83b7\u5f97\u5404\u65b9\u9762\u7684\u6536\u83b7  </li> <li>\u4e0d\u7ba1\u5927\u5bb6\u51fa\u4e8e\u4f55\u79cd\u76ee\u7684\u52a0\u5165\u9752\u534f\uff0c\u5e0c\u671b\u5927\u5bb6\u4e0d\u4ec5\u4ec5\u4e3a\u4e86\u5fd7\u613f\u65f6\u957f\uff0c\u7efc\u6d4b\uff0c\u8fd8\u662f\u5e0c\u671b\u5927\u5bb6\u80fd\u591f\u57f9\u517b\u5fd7\u613f\u7cbe\u795e\u201c\u5949\u732e\uff0c\u53cb\u7231\uff0c\u4e92\u52a9\uff0c\u8fdb\u6b65\u201d\uff0c\u540c\u65f6\u5b66\u4e60\u5230\u7b56\u5212\uff0c\u7ba1\u7406\uff0c\u5b9e\u8df5\uff0c\u65f6\u95f4\u7ba1\u7406\u7b49\u7b49\u65b9\u9762\u7684\u7ecf\u9a8c  </li> </ul>"},{"location":"volunteer/first-meeting-2026-10/#2","title":"2.\u9879\u76ee\u89c4\u5212\u90e8\u5de5\u4f5c","text":"<p>1.\u8fd1\u671f\u5b89\u6392 </p> <pre><code>2026.10.8\n</code></pre> <p>-\u5206\u7ec4\uff0c\u4e00\u517119\u4eba\uff0c\u5206\u4e94\u7ec4\uff0c\u7b2c\u4e00\u7ec43\u4eba\uff0c\u5176\u4f594\u4eba\u3002--\u51c6\u5907\u8868\u683c\uff0c\u5efa\u7fa4\u3002  </p> <pre><code>2026.10.8--2026.10.16\n</code></pre> <ul> <li>\u8054\u7cfb\u5b66\u6821\u5468\u8fb9\u5b66\u6821\uff08\u4e2d\u5c0f\u5b66\uff0c\u5e7c\u513f\u56ed\uff09\uff0c\u517b\u8001\u9662\uff0c\u793e\u533a\uff0c\u515a\u7fa4\u670d\u52a1\u4e2d\u5fc3......  </li> <li>\u8981\u6c42\uff1a\u6bcf\u7ec4\u81f3\u5c11\u8054\u7cfb\u5230\u4e00\u4e2a\u5f00\u5c55\u6d3b\u52a8\u7684\u5730\u65b9</li> <li>\u6d3b\u52a8\u5185\u5bb9\uff1a\u4e3b\u8981\u5ba3\u8bb2\u4e24\u5f39\u4e00\u661f\u7cbe\u795e\uff0c\u7535\u8111\u4e49\u8bca\u670d\u52a1(\u7535\u8111\u6e05\u7070\uff0c\u6e05\u7406\u5185\u5b58......),\u7f16\u7a0b\u6559\u5b66\uff0c\u6559\u8001\u5e74\u4eba\u4f7f\u7528\u7535\u5b50\u8bbe\u5907...... <p>\u8054\u7cfb\u65b9\u6cd5: 1.\u5730\u56fe\u8f6f\u4ef6\u7684\u7535\u8bdd\u53f7\u7801 2.\u76f8\u5173\u793e\u533a\uff0c\u517b\u8001\u9662\u7684\u516c\u4f17\u53f7 3.\u6bcd\u6821\u8001\u5e08 4.\u5148\u627e\u76f8\u5173\u5730\u65b9\u5468\u56f4\u5927\u578b\u5de5\u4f5c\u573a\u5730\u7684\u5de5\u4f5c\u4eba\u5458\uff0c\u518d\u627e\u60f3\u53bb\u5730\u65b9\u7684\u8054\u7cfb\u65b9\u5f0f 5. ......  </p> </li> </ul> <p>\u6ce8\uff1a1.\u6ce8\u610f\u4ea4\u6d41\u8bed\u6c14\uff0c\u63aa\u8f9e\uff0c\u8868\u8fbe\u597d\u610f\u601d\uff0c\u8868\u660e\u4f60\u662f\u8c01\uff0c\u4f60\u8981\u5e72\u4ec0\u4e48\uff0c\u786e\u5b9a\u597d\u65f6\u95f4\uff0c\u5730\u70b9\u7b49\u4e0d\u8981\u56e0\u7d20\u4e4b\u540e\uff0c\u52a0\u5fae\u4fe1\uff0c\u518d\u53d1\u6d88\u606f\u786e\u8ba4\u597d\u76f8\u5173\u4fe1\u606f\u3002  2.\u63d0\u524d\u4e86\u89e3\u6d3b\u52a8\u5185\u5bb9\uff0c\u6d3b\u52a8\u5f00\u5c55\u65b9\u5f0f\uff0c\u4e0d\u61c2\u7684\u53ef\u4ee5\u67e5\uff0c\u53ef\u4ee5\u95ee\u3002  3.\u548c\u8054\u7cfb\u597d\u7684\u573a\u5730\u4fdd\u6301\u597d\u7684\u5370\u8c61\uff0c\u4ee5\u540e\u6709\u522b\u7684\u5fd7\u613f\u6d3b\u52a8\u4e5f\u53ef\u4ee5\u8054\u7cfb\u4ed6\u4eec</p> <p>2.\u5de5\u4f5c\u4e2d\u6ce8\u610f\u4e8b\u9879 - 1.\u867d\u7136\u4f60\u4eec\u5df2\u7ecf\u662f\u9752\u534f\u7684\u4e00\u5458\uff0c\u4f46\u662f\u4f60\u4eec\u548c\u62db\u52df\u5230\u7684\u5fd7\u613f\u8005\u4e00\u6837\uff0c\u90fd\u662f\u5b66\u751f\uff0c\u90fd\u8981\u6ce8\u610f\u6c9f\u901a\uff0c\u4e0d\u80fd\u56e0\u4e3a\u4f60\u662f\u9752\u534f\u5e72\uff0c\u4eba\u5bb6\u662f\u666e\u901a\u5b66\u751f\uff0c\u4f60\u4fe9\u5c31\u6709\u5dee\u8ddd\u4e86\u3002 - 2.\u5fa1\u4eba\u5148\u5fa1\u5df1 \u5f53\u4f60\u4f5c\u4e3a\u8d1f\u8d23\u4eba\u53bb\u5e26\u5fd7\u613f\uff0c\u8981\u505a\u5230\u4e8b\u5fc5\u8eac\u4eb2\uff0c\u4e0d\u80fd\u56e0\u4e3a\u4f60\u662f\u8d1f\u8d23\u4eba\uff0c\u5c31\u53ea\u6307\u6325\u522b\u4eba\uff0c\u81ea\u5df1\u4ec0\u4e48\u4e5f\u4e0d\u5e72\uff0c\u8fd9\u6837\u505a\uff0c\u4e0d\u4ec5\u65e0\u6cd5\u7ed9\u6d3b\u52a8\u5e26\u6765\u987a\u5229\u7684\u8fdb\u5c55\uff0c\u8fd8\u4f1a\u8ba9\u54b1\u4eec\u9752\u534f\u88ab\u8bdf\u75c5\uff0c\u4e0d\u8981\u53d1\u751f\u8fd9\u6837\u7684\u4e8b - 3.\u5f53\u8d1f\u8d23\u4eba\uff0c\u63d0\u524d\u901a\u77e5\u5fd7\u613f\u8005\u76f8\u5173\u4fe1\u606f\uff0c\u5982\uff1a\u96c6\u5408\u65f6\u95f4\uff0c\u5730\u70b9\uff0c\u8981\u51c6\u5907\u4ec0\u4e48\u4e1c\u897f.....,\u6700\u91cd\u8981\uff0c\u8ba9\u5fd7\u613f\u8005\u4eec\u5728\u5fd7\u613f\u6c47\u4e0a\u63d0\u524d\u52a0\u5165\u5c71\u897f\u5927\u5b66\u81ea\u52a8\u5316\u4e0e\u8f6f\u4ef6\u5b66\u9662\u9752\u5e74\u5fd7\u613f\u8005\u534f\u4f1a\uff01\uff01\uff01 - 4.\u5f53\u8d1f\u8d23\u4eba\uff0c\u5728\u6d3b\u52a8\u4e2d\uff0c\u6ce8\u610f\u7ed9\u5e72\u6d3b\u65f6\u7684\u5fd7\u613f\u8005\u62cd\u7167\u3002 - 5.\u5f53\u8d1f\u8d23\u4eba\u51fa\u6d3b\u52a8\u524d\uff0c\u6253\u5370\u7b7e\u5230\u7b7e\u9000\u88682\u5f20\uff0c\u4e00\u5f20\u7b7e\u5230\u65f6\u7b7e\uff0c\u4e00\u5f20\u7b7e\u9000\u65f6\u7b7e\u3002\u6d3b\u52a8\u7ed3\u675f\u540e\uff0c\u5b8c\u6210\u6c47\u603b\u8868\uff0c\u5e76\u5c06\u6c47\u603b\u8868\u5bfc\u51fa\u4e3aexcel\uff0c\u548c\u7b7e\u5230\u7b7e\u9000\u8868\u7684\u7167\u7247\uff0c\u53d1\u7ed9\u90e8\u957f\u3002\u53ca\u65f6\u544a\u8bc9\u5fd7\u613f\u8005\u7b7e\u5230\u7801\uff0c\u5e76\u5728\u5fd7\u613f\u6c47\u4e0a\u7b7e\u5230\uff0c\u7b7e\u9000\u3002\u7b7e\u5230\u7801\u53ea\u80fd\u5728\u5b66\u68211\u516c\u91cc\u8303\u56f4\u5185\u4f7f\u7528\uff0c\u7b7e\u9000\u592a\u665a\u5c31\u65e0\u6cd5\u8bb0\u5f55\u5fd7\u613f\u65f6\u957f\uff0c\u5728\u7fa4\u5185\u7763\u4fc3\u5fd7\u613f\u8005\uff0c\u5efa\u8bae\u591a\u8ba2\u51e0\u4e2a\u95f9\u949f\u3002 - 6.\u5f53\u8d1f\u8d23\u4eba\u51fa\u6d3b\u52a8\u65f6\uff0c\u63d0\u524d\u6765297\u53d6\u8db3\u591f\u7684\u5fd7\u613f\u670d\u548c\u65d7\u5e1c\uff0c\u6d3b\u52a8\u8fc7\u7a0b\u4e2d\uff0c\u5fd7\u613f\u670d\u7a7f\u597d\uff0c\u62c9\u94fe\u62c9\u597d\uff0c\u6ce8\u610f\u5f62\u8c61\u3002 \u6d3b\u52a8\u7ed3\u675f\u540e\uff0c\u8981\u548c\u573a\u5730\u4eba\u5458\u6216\u5fd7\u613f\u8005\u4eec\u81ea\u5df1\u4e0e\u65d7\u5e1c\u5408\u7167\uff0c\u4f53\u73b0\u51fa\u53bb\u4e86\u54ea\u4e2a\u5730\u65b9\u6267\u884c\u6d3b\u52a8\u3002\u8981\u628a\u5fd7\u613f\u670d\u53e0\u597d\u548c\u7b7e\u5230\u7b7e\u9000\u8868\u4e00\u8d77\uff0c\u653e\u56de297\u3002  </p> <ul> <li>7.\u51fa\u5fd7\u613f\uff0c\u6253\u8f66\u8d39AA,(\u5b66\u9662\u7ecf\u8d39\u4e0d\u8db3\uff0c\u4f46\u662f\u5fd7\u613f\u65f6\u957f\u4f1a\u591a\u7ed9)  </li> </ul>"},{"location":"volunteer/first-meeting-2026-10/#3","title":"3.\u522b\u7684\u95ee\u9898\uff0c\u81ea\u7531\u63d0\u95ee","text":""},{"location":"volunteer/staff-performance-evaluation/","title":"\u9752\u534f\u65e5\u7a0b","text":""},{"location":"volunteer/staff-performance-evaluation/#_2","title":"\u9752\u534f\u5e72\u4e8b\u5de5\u4f5c\u540d\u5355","text":""},{"location":"volunteer/staff-performance-evaluation/#_3","title":"\u9752\u534f\u89c4\u5212\u90e8\u4e00\u7ec4","text":""},{"location":"volunteer/staff-performance-evaluation/#_4","title":"\u5b8b\u4f73\u79a7","text":"<ol> <li>2026.10.03 \u9632\u827e\u5fd7\u613f\u6d3b\u52a8\u62a5\u540d </li> <li>2026.10.13 \u6446\u653e\u5355\u8f66\u5fd7\u613f\u6d3b\u52a8\u8d1f\u8d23\u4eba</li> <li>2026.10.14 \u5916\u8054\u8d5e\u52a9\u622a\u56fe\u6536\u96c6</li> </ol>"},{"location":"volunteer/staff-performance-evaluation/#_5","title":"\u738b\u5b50\u5cb3","text":"<ol> <li>2026.10.03 \u9632\u827e\u5fd7\u613f\u6d3b\u52a8\u62a5\u540d  </li> <li>2026.10.03 \u9632\u827e\u5fd7\u613f\u6d3b\u52a8\u62a5\u540d\u6536\u96c6\u6750\u6599</li> </ol>"},{"location":"volunteer/staff-performance-evaluation/#_6","title":"\u738b\u4e00\u8fb0","text":""},{"location":"volunteer/staff-performance-evaluation/#_7","title":"\u9752\u534f\u89c4\u5212\u90e8\u4e8c\u7ec4","text":""},{"location":"volunteer/staff-performance-evaluation/#_8","title":"\u9676\u7476","text":"<ol> <li>2026.10.03 \u9632\u827e\u5fd7\u613f\u6d3b\u52a8\u62a5\u540d</li> <li>2026.20.12 \u81f4\u8fdc\u5b66\u751f\u793e\u533a297\u6574\u7406\u8bc1\u4e66</li> <li>2026.10.13 \u6446\u653e\u5355\u8f66\u5fd7\u613f\u6d3b\u52a8\u8d1f\u8d23\u4eba</li> <li>2026.10.13 \u6c47\u603b\u8868\u6574\u7406</li> </ol>"},{"location":"volunteer/staff-performance-evaluation/#_9","title":"\u674e\u654f\u4f73","text":""},{"location":"volunteer/staff-performance-evaluation/#1-20261003","title":"1. 2026.10.03 \u9632\u827e\u5fd7\u613f\u6d3b\u52a8\u62a5\u540d","text":""},{"location":"volunteer/staff-performance-evaluation/#_10","title":"\u6b66\u948a\u5b87","text":""},{"location":"volunteer/staff-performance-evaluation/#1-20261003_1","title":"1. 2026.10.03 \u9632\u827e\u5fd7\u613f\u6d3b\u52a8\u62a5\u540d","text":""},{"location":"volunteer/staff-performance-evaluation/#_11","title":"\u5f20\u7693\u4e2d","text":"<ol> <li>2026.10.03 \u9632\u827e\u5fd7\u613f\u6d3b\u52a8\u62a5\u540d  </li> <li>2026.10.13 \u7167\u7247pdf\u6536\u96c6 </li> </ol>"},{"location":"volunteer/staff-performance-evaluation/#_12","title":"\u9752\u534f\u89c4\u5212\u90e8\u4e09\u7ec4","text":""},{"location":"volunteer/staff-performance-evaluation/#_13","title":"\u7941\u5609\u9732","text":""},{"location":"volunteer/staff-performance-evaluation/#1-20261003_2","title":"1. 2026.10.03 \u9632\u827e\u5fd7\u613f\u6d3b\u52a8\u62a5\u540d","text":""},{"location":"volunteer/staf